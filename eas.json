{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RUSTORE_ENABLED": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RUSTORE_ENABLED": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "rustore": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RUSTORE_ENABLED": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
